# ============================================================================
# NEPHRODESK AI PRO — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO VERSION CONTROL
# ============================================================================

NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# Database Configuration (PostgreSQL 15+ with TLS in production)
DATABASE_URL=postgresql://nephrodesk_app:CHANGE_ME_IN_VAULT@localhost:5432/nephrodesk_db?sslmode=require
DB_POOL_MIN=2
DB_POOL_MAX=10

# Authentication & Session Security
SESSION_SECRET=REPLACE_WITH_64_BYTE_CRYPTOGRAPHIC_RANDOM_HEX_FROM_SECRET_MANAGER
SESSION_TTL_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=15
MFA_REQUIRED_FOR_CLINICIANS=true
BCRYPT_WORK_FACTOR=12

# Rate Limiting & Brute-Force Protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# CORS & Transport Security
ALLOWED_ORIGINS=https://nephrodesk.clinical-internal.example.org
FORCE_HTTPS=true

# Backup & Retention Governance
BACKUP_ENCRYPTION_KEY_ID=arn:aws:kms:eu-west-3:000000000000:key/REPLACE_ME
AUDIT_LOG_RETENTION_DAYS=2555
CLINICAL_RECORD_RETENTION_YEARS=20

# Controlled AI Assistance (Disabled by default; requires institutional DPIA & BAA)
AI_ASSISTANT_ENABLED=false
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_API_KEY=
AI_ALLOW_PHI_TRANSMISSION=false
